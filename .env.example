# Home Assistant base URL, as seen from where this server runs
HA_URL=http://homeassistant.local:8123
# Long-lived access token (HA profile -> Security -> Long-lived access tokens)
HA_TOKEN=

# Secret that clients must present. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# http (default, for remote connectors) or stdio (for local Claude Desktop / Claude Code)
MCP_TRANSPORT=http
PORT=3000
HOST=0.0.0.0

# Set to false to remove the ha_render_template tool
ENABLE_TEMPLATE_TOOL=true
