# Home Assistant base URL, as seen from where this server runs
HA_URL=http://homeassistant.local:8123
# Long-lived access token (HA profile -> Security -> Long-lived access tokens)
HA_TOKEN=

# Secret that clients must present. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# http (default, for remote connectors) or stdio (for local Claude Desktop / Claude Code)
MCP_TRANSPORT=http
PORT=3000
HOST=0.0.0.0

# trace|debug|info|notice|warning|error|fatal. At info every request is logged
# (method, tool, client IP, status, duration; never the token).
LOG_LEVEL=info

# ---- Capabilities. The defaults below keep the server read-only.
# Set to false to remove the ha_render_template tool
ENABLE_TEMPLATE_TOOL=true
# Control devices / call services
ENABLE_ACTIONS=false
# Create/edit YAML files in CONFIG_DIR (needs CONFIG_DIR)
ENABLE_CONFIG_FILES=false
# Integrations, registries, automations, helpers; add-ons/backups/host need the Supervisor
ENABLE_MANAGEMENT=false
# Comma-separated domains that can never be controlled. Recommended:
BLOCKED_DOMAINS=lock,alarm_control_panel

# HA config folder as seen inside the container (mount it in docker-compose.yml).
# Empty = no config file tools.
CONFIG_DIR=

# Supervisor API (only exists on Home Assistant OS / Supervised, normally only
# reachable from inside an add-on). Empty = no add-on/backup/host/update tools.
SUPERVISOR_URL=
SUPERVISOR_TOKEN=
